# ==============================================================================
# FITPULSE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env untuk menjalankan lokal dengan TiDB Cloud:
#   copy .env.example .env
#
# Di Vercel, masukkan variabel di bawah ini ke menu Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION URL (TiDB Cloud Serverless / MySQL / SQLite)
# ------------------------------------------------------------------------------
# TiDB Cloud Serverless (Rekomendasi untuk hosting Vercel & Multi-User):
# Format: mysql+pymysql://<user>:<password>@<host>:4000/<database>?ssl_verify_cert=true
DATABASE_URL=mysql+pymysql://xxxxxx.root:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/fitpulse?ssl_verify_cert=true

# Catatan: Jika DATABASE_URL dikosongkan, FitPulse otomatis menggunakan
# database lokal SQLite (workout_data/fitpulse.db) untuk offline/development.

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani JWT token (Gunakan string acak minimal 32 karakter)
JWT_SECRET=fitpulse-cloud-production-jwt-secret-key-32charsmin

# Algoritma enkripsi JWT (Default: HS256)
JWT_ALGORITHM=HS256

# Durasi masa berlaku token login dalam menit (Default: 43200 menit = 30 hari)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

